{
  "name": "@crystal-ui/react",
  "version": "0.1.0-alpha.1",
  "description": "React components for the Crystal design system, built on React Aria.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.js",
      "require": "./dist/blocks.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./component-manifest.json": "./dist/component-manifest.json",
    "./llms.txt": "./dist/llms.txt"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "pnpm run tokens && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/check-bundle.mjs && pnpm run manifest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify": "pnpm run lint:tokens && pnpm run typecheck && pnpm run verify:stories && pnpm run test && pnpm run test:jest && pnpm run build",
    "manifest": "node scripts/build-manifest.mjs",
    "verify:stories": "node scripts/verify-stories.mjs",
    "verify:targets": "node scripts/verify-targets.mjs",
    "verify:behaviour": "node scripts/verify-behaviour.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:materials": "node scripts/verify-materials.mjs",
    "verify:appearance": "node scripts/verify-appearance.mjs",
    "test:jest": "jest",
    "sync:slice-r": "node scripts/sync-slice-r.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-subscript": "^3.31.4",
    "@tiptap/extension-superscript": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-highlight": {
      "optional": true
    },
    "@tiptap/extension-list": {
      "optional": true
    },
    "@tiptap/extension-subscript": {
      "optional": true
    },
    "@tiptap/extension-superscript": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    }
  },
  "dependencies": {
    "@crystal-ui/core": "^2.3.0",
    "@internationalized/date": "^3.12.4",
    "@internationalized/number": "^3.6.8",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "motion": "13.4.0",
    "qrcode.react": "^4.2.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-imask": "^7.6.1",
    "react-stately": "^3.50.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "autoprefixer": "^10.6.1",
    "babel-jest": "^30.5.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.104.1",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1",
    "vitest-axe": "^0.1.0"
  }
}
